# Required for npm install (Motion+ private package)
# https://motion.dev/dashboard/tokens
#
# Local:
#   PowerShell:  $env:MOTION_TOKEN="your-token"; npm install
#   bash:        export MOTION_TOKEN=your-token && npm install
#
# Vercel: Project → Settings → Environment Variables
#   Name:  MOTION_TOKEN
#   Value: (your token)
#   Environments: Production, Preview, Development
#   (Must be available during Install + Build)
MOTION_TOKEN=
